APP_ENV=development

# Lokasi data (relatif ke folder backend/). Default sudah sesuai struktur repo.
DATABASE_PATH=./batikmatch.db
ARTIFACTS_DIR=../artifacts
OUTPUTS_DIR=../outputs
# Folder dataset berisi TRAIN/ dan TEST/ (sama dengan DATA_DIR di notebook)
DATA_DIR=../data/raw
# Galeri model histogram dan sumber gambar /images/{id}
GALLERY_DIR=../data/raw/TRAIN
UPLOAD_DIR=./uploads

# Kosongkan supaya otomatis memilih model fine-tuned kalau ada
DEFAULT_MODEL=
# Skor di bawah ini dianggap "motif tidak dikenal". Per model bisa diatur di artifacts/thresholds.json
THRESHOLD_YAKIN=0.70
LABEL_SANGAT_MIRIP=0.85
LABEL_CUKUP_MIRIP=0.70
DEFAULT_TOP_K=3
MAX_TOP_K=15

# Upload
MAX_UPLOAD_MB=5
ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Admin (WAJIB diganti sebelum demo publik / ngrok)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SECRET_KEY=ganti-dengan-teks-acak-panjang
TOKEN_HOURS=12

# CORS. CORS_ALLOW_LOCALHOST=true mengizinkan localhost di port mana pun (untuk development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_LOCALHOST=true
