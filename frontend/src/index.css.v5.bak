@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    @apply bg-nila font-sans text-nila antialiased;
  }
  h1,
  h2,
  h3 {
    @apply font-display;
  }
  button:focus-visible,
  a:focus-visible,
  input:focus-visible {
    outline: 3px solid #e0b04a;
    outline-offset: 2px;
  }
}

/* Pola batik dibuat dari CSS, jadi tidak perlu file gambar */
@layer components {
  .pola-kawung {
    background-color: #24396b;
    background-image:
      radial-gradient(circle at 25% 25%, transparent 0 7px, #e0b04a 7px 8px, transparent 8px),
      radial-gradient(circle at 75% 75%, transparent 0 7px, #e0b04a 7px 8px, transparent 8px);
    background-size: 32px 32px;
  }
  .pola-parang {
    background-color: #8a5a2b;
    background-image:
      repeating-linear-gradient(135deg, #e8d3a8 0 4px, transparent 4px 18px),
      repeating-linear-gradient(135deg, rgba(20, 33, 61, 0.55) 0 8px, transparent 8px 18px);
  }
  .pola-megamendung {
    background-color: #14213d;
    background-image: repeating-radial-gradient(circle at 30% 70%, #4a6fb0 0 3px, transparent 3px 11px);
  }
  .pola-ceplok {
    background-color: #f1e7d0;
    background-image:
      radial-gradient(circle, #8a5a2b 0 3px, transparent 3.5px),
      linear-gradient(#c9b48a 1px, transparent 1px),
      linear-gradient(90deg, #c9b48a 1px, transparent 1px);
    background-size: 24px 24px;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
  }
}
.pola-halus {
  background-color: #14213d;
  background-image:
    radial-gradient(circle at 50% 50%, transparent 0 13px, rgba(224, 176, 74, 0.22) 13px 14px, transparent 14px),
    radial-gradient(circle at 0 0, transparent 0 13px, rgba(224, 176, 74, 0.22) 13px 14px, transparent 14px),
    radial-gradient(circle at 100% 100%, transparent 0 13px, rgba(224, 176, 74, 0.22) 13px 14px, transparent 14px);
  background-size: 40px 40px;
}
/* Pita segitiga (tumpal) seperti tepi kain batik */
.pita-tumpal {
  height: 12px;
  background-color: #14213d;
  background-image:
    linear-gradient(135deg, #e0b04a 25%, transparent 25%),
    linear-gradient(225deg, #e0b04a 25%, transparent 25%);
  background-size: 24px 24px;
}
.pola-lerek {
  background-image:
    linear-gradient(45deg, rgba(224, 176, 74, 0.28) 1px, transparent 1px),
    linear-gradient(-45deg, rgba(224, 176, 74, 0.28) 1px, transparent 1px);
  background-size: 28px 28px;
}
.tekstur-kain {
  background-color: #FAF8F5;
  background-image: radial-gradient(rgba(20, 33, 61, 0.04) 1px, transparent 0);
  background-size: 20px 20px;
}

@keyframes floatSlow {
  0%, 100% { transform: translateY(0px) rotate(var(--rot, 0deg)); }
  50% { transform: translateY(-6px) rotate(var(--rot, 0deg)); }
}

.anim-kain {
  animation: floatSlow 6s ease-in-out infinite;
}