import { useState } from "react";
import { useNavigate } from "react-router-dom";

const HATI = "M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z";

export function LingkaranFotoBatik({ motif, srcManual, className = "" }) {
  const [gagal, setGagal] = useState(false);
  const sumber = srcManual || motif?.gambar || `/motif/${motif?.id}.jpg`;

  return (
    <div className={`overflow-hidden rounded-full bg-[#EFEAE2] shadow-[0_14px_28px_rgba(38,20,9,0.28)] ring-[5px] ring-white ${className}`}>
      {!gagal && sumber ? (
        <img
          src={sumber}
          alt={motif ? `Motif ${motif.nama}` : "Foto kain batik"}
          onError={() => setGagal(true)}
          className="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <div className={`h-full w-full ${motif?.pola || "pola-kawung"}`} role="img" aria-label={motif?.nama || "Motif batik"} />
      )}
    </div>
  );
}

export default function KartuMotifBaru({ motif, favorit, onToggle, label }) {
  const nav = useNavigate();

  return (
    <article
      onClick={() => nav("/hasil", { state: { contohId: motif.id } })}
      className="group relative mt-14 cursor-pointer select-none pt-2"
    >
      {/* Foto Lingkaran Mengambang di Atas Kartu */}
      <div className="relative z-10 mx-auto -mb-16 h-32 w-32 transition-transform duration-500 ease-out group-hover:-translate-y-2 group-hover:scale-105 sm:h-36 sm:w-36">
        <LingkaranFotoBatik motif={motif} className="h-full w-full" />
      </div>

      {/* Badan Kartu Cokelat Sogan Gradasi */}
      <div className="bg-sogan-grad relative rounded-[30px] px-5 pb-5 pt-20 text-white shadow-[0_16px_32px_rgba(38,20,9,0.18)] transition-all duration-300 group-hover:shadow-[0_22px_40px_rgba(38,20,9,0.28)]">
        {onToggle && (
          <button
            type="button"
            onClick={(e) => { e.stopPropagation(); onToggle(motif.id); }}
            aria-pressed={favorit}
            aria-label={favorit ? `Hapus ${motif.nama} dari favorit` : `Simpan ${motif.nama} ke favorit`}
            className="absolute right-4 top-4 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-sm transition hover:scale-110 hover:bg-white/25"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" strokeWidth="2" strokeLinejoin="round"
              fill={favorit ? "#C99A6B" : "none"} stroke={favorit ? "#C99A6B" : "currentColor"} aria-hidden="true">
              <path d={HATI} />
            </svg>
          </button>
        )}

        <h3 className="font-display text-2xl font-bold leading-tight tracking-wide text-white">
          {motif.nama}
        </h3>

        {/* Badge daerah berlatar transparan seperti badge rating ★ 4.3 */}
        <div className="mt-2 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-xs font-medium text-[#FAF7F2]">
          <span className="text-karamel">✦</span>
          <span>{motif.daerah}</span>
        </div>

        <p className="mt-3 line-clamp-1 text-xs text-white/65">
          {label || "Klasik Nusantara"}
        </p>

        <div className="mt-4 flex items-center justify-between">
          <span className="text-sm font-semibold text-[#FAF7F2]/90">Lihat detail</span>
          <span className="text-sogan-tua flex h-10 w-10 items-center justify-center rounded-full bg-white text-xl font-bold shadow-md transition-transform duration-300 group-hover:scale-110">
            +
          </span>
        </div>
      </div>
    </article>
  );
}