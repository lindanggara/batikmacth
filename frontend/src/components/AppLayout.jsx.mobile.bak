import { NavLink, Link, Outlet } from "react-router-dom";

const IKON = {
  home: "M4 11l8-7 8 7v9a1 1 0 01-1 1h-4v-6H9v6H5a1 1 0 01-1-1z",
  grid: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z",
  heart: "M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z",
  info: "M12 3a9 9 0 100 18 9 9 0 000-18zM12 11v5M12 8v.01",
  kamera: "M4 8h3l2-3h6l2 3h3v11H4zM12 10a3.5 3.5 0 100 7 3.5 3.5 0 000-7z",
};

function Ikon({ d, size = 24 }) {
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
      strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d={d} />
    </svg>
  );
}

function Item({ to, label, d, end }) {
  return (
    <NavLink to={to} end={end} aria-label={label}
      className={({ isActive }) =>
        `flex h-12 w-12 items-center justify-center rounded-full ${isActive ? "text-malam" : "text-white/60"}`}>
      <Ikon d={d} />
    </NavLink>
  );
}

export default function AppLayout({ children }) {
  return (
    <div className="min-h-screen bg-[#EEF1F7] text-nila">
      <div className="mx-auto min-h-screen max-w-md px-5 pb-32 pt-8">
        {children ?? <Outlet />}
        <p className="pt-10 text-center text-xs text-mute">
          BatikLens, proyek Neuro Computing.{" "}
          <Link to="/admin/login" className="underline">Admin</Link>
        </p>
      </div>

      <nav aria-label="Menu utama"
        className="fixed bottom-4 left-1/2 z-20 flex h-[68px] w-[calc(100%-2rem)] max-w-[28rem] -translate-x-1/2 items-center justify-between rounded-[34px] bg-nila px-5 shadow-2xl">
        <div className="flex gap-1">
          <Item to="/" end label="Beranda" d={IKON.home} />
          <Item to="/jelajah" label="Jelajah" d={IKON.grid} />
        </div>
        <Link to="/" aria-label="Ambil foto"
          className="-mt-9 flex h-16 w-16 items-center justify-center rounded-full bg-malam text-nila shadow-lg ring-[6px] ring-[#EEF1F7]">
          <Ikon d={IKON.kamera} size={28} />
        </Link>
        <div className="flex gap-1">
          <Item to="/favorit" label="Favorit" d={IKON.heart} />
          <Item to="/tentang" label="Tentang" d={IKON.info} />
        </div>
      </nav>
    </div>
  );
}