export default function KartuMotifBaru({ motif, favorit, onToggle, label }) {
  return (
    <article className="rounded-[28px] bg-white p-2.5 shadow-sm ring-1 ring-nila/5">
      <div className={`relative aspect-square rounded-3xl ${motif.pola}`}>
        <button
          type="button"
          onClick={() => onToggle(motif.id)}
          aria-pressed={favorit}
          aria-label={favorit ? `Hapus ${motif.nama} dari favorit` : `Simpan ${motif.nama} ke favorit`}
          className="absolute right-2 top-2 flex h-11 w-11 items-center justify-center rounded-full bg-white/95 text-soga shadow"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" strokeWidth="2" strokeLinejoin="round"
            fill={favorit ? "currentColor" : "none"} stroke="currentColor" aria-hidden="true">
            <path d="M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z" />
          </svg>
        </button>
      </div>
      <h3 className="mt-2 px-1 font-display text-base font-semibold">{motif.nama}</h3>
      <p className="px-1 text-sm text-mute">{motif.daerah}</p>
      {label && <p className="px-1 pb-1 text-xs font-semibold text-soga">{label}</p>}
    </article>
  );
}