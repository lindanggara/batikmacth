import { NavLink, Link, Outlet } from "react-router-dom";

const IKON = {
  home: "M4 11l8-7 8 7v9a1 1 0 01-1 1h-4v-6H9v6H5a1 1 0 01-1-1z",
  grid: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z",
  heart: "M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z",
  info: "M12 3a9 9 0 100 18 9 9 0 000-18zM12 11v5M12 8v.01",
};

const MENU = [
  { to: "/", label: "Beranda", end: true, d: IKON.home },
  { to: "/jelajah", label: "Jelajah", d: IKON.grid },
  { to: "/favorit", label: "Favorit", d: IKON.heart },
  { to: "/tentang", label: "Tentang", d: IKON.info },
];

function Ikon({ d }) {
  return (
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d={d} />
    </svg>
  );
}

export default function AppLayout({ children }) {
  return (
    <div className="min-h-screen bg-[#F4F5F8] text-nila">
      <header className="sticky top-0 z-30 border-b border-nila/10 bg-[#F4F5F8]/90 backdrop-blur">
        <div className="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 lg:h-20 lg:px-8">
          <Link to="/" className="flex items-center gap-2.5 font-display text-2xl font-semibold">
            <svg width="12" height="12" viewBox="0 0 14 14" className="text-malam" aria-hidden="true">
              <path d="M7 0l7 7-7 7-7-7z" fill="currentColor" />
            </svg>
            BatikLens
          </Link>
          <nav aria-label="Menu utama" className="hidden gap-9 lg:flex">
            {MENU.map((m) => (
              <NavLink key={m.to} to={m.to} end={m.end}
                className={({ isActive }) =>
                  `border-b-2 pb-1 text-sm font-medium ${isActive ? "border-malam text-nila" : "border-transparent text-nila/60 hover:text-nila"}`}>
                {m.label}
              </NavLink>
            ))}
          </nav>
        </div>
      </header>

      <div className="mx-auto max-w-6xl px-5 pb-28 pt-8 lg:px-8 lg:pb-20 lg:pt-12">
        {children ?? <Outlet />}
        <footer className="mt-16 border-t border-nila/10 pt-6 text-center text-xs text-mute">
          BatikLens, proyek Neuro Computing.{" "}
          <Link to="/admin/login" className="underline">Admin</Link>
        </footer>
      </div>

      <nav aria-label="Menu bawah" className="fixed inset-x-0 bottom-0 z-20 grid grid-cols-4 border-t border-nila/10 bg-white lg:hidden">
        {MENU.map((m) => (
          <NavLink key={m.to} to={m.to} end={m.end}
            className={({ isActive }) =>
              `-mt-px flex min-h-[58px] flex-col items-center justify-center gap-0.5 border-t-2 text-xs font-medium ${isActive ? "border-malam text-nila" : "border-transparent text-nila/55"}`}>
            <Ikon d={m.d} />
            {m.label}
          </NavLink>
        ))}
      </nav>
    </div>
  );
}