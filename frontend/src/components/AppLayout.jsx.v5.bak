import { NavLink, Link, Outlet } from "react-router-dom";

const IKON = {
  home: "M4 11l8-7 8 7v9a1 1 0 01-1 1h-4v-6H9v6H5a1 1 0 01-1-1z",
  grid: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z",
  heart: "M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z",
  info: "M12 3a9 9 0 100 18 9 9 0 000-18zM12 11v5M12 8v.01",
};

const MENU = [
  { to: "/", label: "Beranda", end: true, d: IKON.home },
  { to: "/jelajah", label: "Jelajah", d: IKON.grid },
  { to: "/favorit", label: "Favorit", d: IKON.heart },
  { to: "/tentang", label: "Tentang", d: IKON.info },
];

function Ikon({ d }) {
  return (
    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      strokeWidth="1.75" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d={d} />
    </svg>
  );
}

function Belah() {
  return (
    <svg width="14" height="14" viewBox="0 0 14 14" className="text-malam transition-transform duration-500 group-hover:rotate-90" aria-hidden="true">
      <path d="M7 0l7 7-7 7-7-7z" fill="currentColor" />
    </svg>
  );
}

export default function AppLayout({ children }) {
  return (
    <div className="tekstur-kain flex min-h-screen flex-col text-nila selection:bg-malam/30">
      <header className="sticky top-0 z-30 bg-nila/95 text-kain shadow-md backdrop-blur-md">
        <div className="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 lg:h-20 lg:px-8">
          <Link to="/" className="group flex items-center gap-3 font-display text-2xl font-semibold tracking-wide lg:text-3xl">
            <Belah />
            <span>BatikLens</span>
          </Link>
          <nav aria-label="Menu utama" className="hidden items-center gap-10 lg:flex">
            {MENU.map((m) => (
              <NavLink key={m.to} to={m.to} end={m.end}
                className={({ isActive }) =>
                  `relative py-2 text-sm font-medium tracking-wide transition-colors ${
                    isActive
                      ? "text-malam after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:bg-malam"
                      : "text-kain/70 hover:text-kain"
                  }`}>
                {m.label}
              </NavLink>
            ))}
          </nav>
        </div>
        <div className="pita-tumpal opacity-90" aria-hidden="true" />
      </header>

      <main className="mx-auto w-full max-w-6xl flex-1 px-5 pb-24 pt-8 lg:px-8 lg:pb-20 lg:pt-12">
        {children ?? <Outlet />}
      </main>

      <footer className="bg-nila text-kain">
        <div className="pita-tumpal opacity-90" aria-hidden="true" />
        <div className="mx-auto grid max-w-6xl gap-8 px-5 py-12 pb-28 lg:grid-cols-[1.2fr_auto] lg:items-center lg:px-8 lg:pb-12">
          <div>
            <p className="flex items-center gap-2.5 font-display text-2xl font-semibold tracking-wide">
              <Belah /> BatikLens
            </p>
            <p className="mt-2 max-w-md text-sm leading-relaxed text-kain/65">
              Mengenali dan mengarsipkan keindahan motif batik Nusantara melalui visi komputer. Proyek Praktikum Neuro Computing.
            </p>
          </div>
          <nav aria-label="Tautan footer" className="flex flex-wrap gap-x-8 gap-y-3 text-sm text-kain/75">
            {MENU.map((m) => (
              <Link key={m.to} to={m.to} className="transition-colors hover:text-malam">
                {m.label}
              </Link>
            ))}
            <Link to="/admin/login" className="text-kain/45 transition-colors hover:text-malam">
              Admin
            </Link>
          </nav>
        </div>
      </footer>

      <nav aria-label="Menu bawah" className="fixed inset-x-0 bottom-0 z-20 grid grid-cols-4 border-t border-nila/10 bg-white/95 backdrop-blur-md lg:hidden">
        {MENU.map((m) => (
          <NavLink key={m.to} to={m.to} end={m.end}
            className={({ isActive }) =>
              `-mt-px flex min-h-[60px] flex-col items-center justify-center gap-1 border-t-2 text-[11px] font-medium transition-colors ${
                isActive ? "border-malam text-nila" : "border-transparent text-nila/50 hover:text-nila/80"
              }`}>
            <Ikon d={m.d} />
            {m.label}
          </NavLink>
        ))}
      </nav>
    </div>
  );
}