import { NavLink, Link, Outlet } from "react-router-dom";

const menu = [
  { to: "/", label: "Cari", end: true, path: "M11 4a7 7 0 100 14 7 7 0 000-14zM20 20l-4-4" },
  { to: "/jelajah", label: "Jelajah", path: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" },
  { to: "/favorit", label: "Favorit", path: "M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z" },
  { to: "/tentang", label: "Tentang", path: "M12 3a9 9 0 100 18 9 9 0 000-18zM12 11v5M12 8v.01" },
];

function Icon({ d }) {
  return (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d={d} />
    </svg>
  );
}

// children dipakai kalau App.jsx membungkus halaman, Outlet kalau memakai nested route
export default function AppLayout({ children }) {
  return (
    <div className="flex min-h-screen flex-col bg-nila text-kain">
      <header className="relative overflow-hidden">
        <div className="pola-kawung absolute inset-0 opacity-30" aria-hidden="true" />
        <div className="absolute inset-0 bg-gradient-to-b from-transparent to-nila" aria-hidden="true" />
        <div className="relative mx-auto flex max-w-3xl items-center justify-between px-5 pb-10 pt-6">
          <Link to="/" className="flex items-center gap-3">
            <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-malam font-display text-xl font-bold text-nila">
              B
            </span>
            <span className="font-display text-xl font-bold">BatikLens</span>
          </Link>
          <nav aria-label="Menu utama" className="hidden gap-1 md:flex">
            {menu.map((m) => (
              <NavLink
                key={m.to}
                to={m.to}
                end={m.end}
                className={({ isActive }) =>
                  `rounded-full px-4 py-2 text-sm font-semibold ${
                    isActive ? "bg-malam text-nila" : "text-kain/80 hover:text-kain"
                  }`
                }
              >
                {m.label}
              </NavLink>
            ))}
          </nav>
        </div>
      </header>

      <main className="-mt-6 flex-1 rounded-t-[32px] bg-kain px-5 pb-28 pt-8 text-nila md:pb-12">
        <div className="mx-auto max-w-3xl">{children ?? <Outlet />}</div>
        <p className="mx-auto mt-10 max-w-3xl text-center text-xs text-mute">
          BatikLens, proyek Neuro Computing.{" "}
          <Link to="/admin/login" className="underline">Admin</Link>
        </p>
      </main>

      <nav
        aria-label="Menu bawah"
        className="fixed inset-x-4 bottom-4 z-20 flex h-16 items-center justify-around rounded-full bg-kain shadow-xl md:hidden"
      >
        {menu.map((m) => (
          <NavLink
            key={m.to}
            to={m.to}
            end={m.end}
            aria-label={m.label}
            className={({ isActive }) =>
              `flex h-12 w-14 items-center justify-center rounded-full ${
                isActive ? "bg-malam text-nila" : "text-mute"
              }`
            }
          >
            <Icon d={m.path} />
          </NavLink>
        ))}
      </nav>
    </div>
  );
}