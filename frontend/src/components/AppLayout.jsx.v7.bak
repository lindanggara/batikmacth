import { NavLink, Link, Outlet } from "react-router-dom";

const IKON = {
  home: "M4 11l8-7 8 7v9a1 1 0 01-1 1h-4v-6H9v6H5a1 1 0 01-1-1z",
  grid: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z",
  heart: "M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z",
  info: "M12 3a9 9 0 100 18 9 9 0 000-18zM12 11v5M12 8v.01",
};

const MENU = [
  { to: "/", label: "Beranda", end: true, d: IKON.home },
  { to: "/jelajah", label: "Jelajah Koleksi", d: IKON.grid },
  { to: "/favorit", label: "Favorit", d: IKON.heart },
  { to: "/tentang", label: "Tentang", d: IKON.info },
];

function Ikon({ d }) {
  return (
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
      strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      <path d={d} />
    </svg>
  );
}

export default function AppLayout({ children }) {
  return (
    <div className="flex min-h-screen flex-col bg-[#F5EFE6] text-nila selection:bg-malam/30">
      <header className="sticky top-0 z-30 bg-[#101B33]/95 text-kain shadow-lg backdrop-blur-md">
        <div className="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 lg:h-20 lg:px-8">
          <Link to="/" className="group flex items-center gap-3">
            <span className="flex h-9 w-9 items-center justify-center rounded-xl border border-malam/70 bg-nila-deep text-malam shadow-inner transition-transform duration-300 group-hover:rotate-45">
              <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true">
                <path d="M7 0l7 7-7 7-7-7z" fill="currentColor" />
              </svg>
            </span>
            <div>
              <span className="block font-display text-2xl font-bold leading-none tracking-wide text-kain">BatikLens</span>
              <span className="block text-[10px] tracking-[0.2em] text-malam uppercase">Arsip &amp; Visi Nusantara</span>
            </div>
          </Link>

          <nav aria-label="Menu utama" className="hidden items-center gap-8 lg:flex">
            {MENU.map((m) => (
              <NavLink key={m.to} to={m.to} end={m.end}
                className={({ isActive }) =>
                  `relative py-2 text-sm font-medium tracking-wide transition-colors ${
                    isActive
                      ? "text-malam after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:bg-malam"
                      : "text-kain/75 hover:text-kain"
                  }`}>
                {m.label}
              </NavLink>
            ))}
          </nav>

          <Link to="/jelajah" className="hidden rounded-full border border-malam/60 bg-malam/15 px-5 py-2 text-xs font-semibold tracking-wider text-malam uppercase transition hover:bg-malam hover:text-nila lg:inline-flex">
            15+ Motif Klasik
          </Link>
        </div>
        <div className="pita-tumpal" aria-hidden="true" />
      </header>

      <main className="mx-auto w-full max-w-6xl flex-1 px-5 pb-24 pt-7 lg:px-8 lg:pb-20 lg:pt-10">
        {children ?? <Outlet />}
      </main>

      <footer className="bg-[#101B33] text-kain">
        <div className="pita-tumpal" aria-hidden="true" />
        <div className="mx-auto grid max-w-6xl gap-8 px-5 py-12 pb-28 lg:grid-cols-[1.2fr_auto] lg:items-center lg:px-8 lg:pb-12">
          <div>
            <p className="font-display text-2xl font-bold tracking-wide text-malam">BatikLens</p>
            <p className="mt-2 max-w-md text-sm leading-relaxed text-kain/70">
              Eksplorasi warisan wastra Indonesia berbasis kecerdasan buatan. Mengenali motif, filosofi, dan daerah asal dari satu tangkapan kamera.
            </p>
          </div>
          <nav aria-label="Tautan footer" className="flex flex-wrap gap-x-7 gap-y-3 text-sm text-kain/80">
            {MENU.map((m) => (
              <Link key={m.to} to={m.to} className="transition-colors hover:text-malam">
                {m.label}
              </Link>
            ))}
            <Link to="/admin/login" className="text-kain/45 transition-colors hover:text-malam">
              Panel Admin
            </Link>
          </nav>
        </div>
      </footer>

      <nav aria-label="Menu bawah" className="fixed inset-x-0 bottom-0 z-20 grid grid-cols-4 border-t border-malam/30 bg-[#101B33]/95 text-kain backdrop-blur-md lg:hidden">
        {MENU.map((m) => (
          <NavLink key={m.to} to={m.to} end={m.end}
            className={({ isActive }) =>
              `flex min-h-[60px] flex-col items-center justify-center gap-1 text-[11px] font-medium transition-colors ${
                isActive ? "text-malam" : "text-kain/60 hover:text-kain"
              }`}>
            <Ikon d={m.d} />
            {m.label}
          </NavLink>
        ))}
      </nav>
    </div>
  );
}