const HATI = "M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z";

export default function KartuMotifBaru({ motif, favorit, onToggle, label, besar }) {
  const tombol = onToggle && (
    <button
      type="button"
      onClick={(e) => { e.preventDefault(); onToggle(motif.id); }}
      aria-pressed={favorit}
      aria-label={favorit ? `Hapus ${motif.nama} dari favorit` : `Simpan ${motif.nama} ke favorit`}
      className="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-soga shadow-md backdrop-blur-sm transition-transform duration-200 hover:scale-110 active:scale-95"
    >
      <svg width="19" height="19" viewBox="0 0 24 24" strokeWidth="1.8" strokeLinejoin="round"
        fill={favorit ? "currentColor" : "none"} stroke="currentColor" aria-hidden="true">
        <path d={HATI} />
      </svg>
    </button>
  );

  if (besar) {
    return (
      <article className="group relative aspect-[4/5] overflow-hidden rounded-[26px] bg-nila shadow-md ring-1 ring-malam/50 transition-all duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:ring-malam">
        <div className={`absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-105 ${motif.pola}`} />
        <div className="absolute inset-0 bg-gradient-to-t from-nila-deep/95 via-nila-deep/30 to-transparent opacity-90 transition-opacity duration-300 group-hover:opacity-100" />
        {tombol}
        <div className="absolute inset-x-0 bottom-0 p-5 text-kain">
          <div className="mb-1.5 h-[1px] w-8 bg-malam/70 transition-all duration-300 group-hover:w-14" />
          <h3 className="font-display text-2xl font-semibold leading-tight tracking-wide">{motif.nama}</h3>
          <p className="mt-0.5 text-xs tracking-wider text-kain/75 uppercase">{motif.daerah}</p>
          {label && <p className="mt-1.5 inline-block rounded-full bg-malam/20 px-2.5 py-0.5 text-xs font-medium text-malam">{label}</p>}
        </div>
      </article>
    );
  }

  return (
    <article className="group">
      <div className="relative overflow-hidden rounded-2xl bg-white p-1.5 shadow-sm ring-1 ring-malam/50 transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-md group-hover:ring-malam">
        <div className="overflow-hidden rounded-xl">
          <div className={`aspect-square transition-transform duration-500 group-hover:scale-105 ${motif.pola}`} />
        </div>
        {tombol}
      </div>
      <h3 className="mt-3 font-display text-xl font-semibold leading-tight transition-colors group-hover:text-soga">{motif.nama}</h3>
      <p className="text-xs tracking-wide text-mute uppercase">{motif.daerah}</p>
      {label && <p className="mt-1 text-xs font-semibold text-soga">{label}</p>}
    </article>
  );
}