import { useMemo, useRef, useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { KATALOG } from "../data/katalogMotif";
import KartuMotifBaru from "../components/KartuMotifBaru";
import useFavoritLokal from "../hooks/useFavoritLokal";

const MAKS_MB = 10;

export default function HomePage() {
  const nav = useNavigate();
  const fav = useFavoritLokal();
  const kamera = useRef(null);
  const galeri = useRef(null);
  const [error, setError] = useState("");
  const [daerah, setDaerah] = useState("Semua");
  const [cari, setCari] = useState("");
  const [seret, setSeret] = useState(false);

  const daftarDaerah = useMemo(
    () => ["Semua", ...Array.from(new Set(KATALOG.map((m) => m.daerah))).slice(0, 5)],
    []
  );

  const daftarTampil = useMemo(() => {
    return KATALOG.filter(
      (m) =>
        (daerah === "Semua" || m.daerah === daerah) &&
        m.nama.toLowerCase().includes(cari.trim().toLowerCase())
    );
  }, [daerah, cari]);

  function proses(file) {
    setError("");
    if (!file) return;
    if (!file.type.startsWith("image/")) return setError("File harus berupa foto (JPG atau PNG).");
    if (file.size > MAKS_MB * 1024 * 1024) return setError(`Ukuran foto maksimal ${MAKS_MB} MB.`);
    nav("/hasil", { state: { file } });
  }

  return (
    <div className="space-y-8">
      {/* Top Bar Mobile Selaras dengan Referensi */}
      <div className="flex items-center justify-between lg:hidden">
        <span className="bg-sogan-grad flex h-10 w-10 items-center justify-center rounded-full text-xs font-bold text-white shadow-sm">
          ✦
        </span>
        <div className="flex items-center gap-1.5 text-sm font-bold">
          <span className="text-karamel">📍</span>
          <span>BatikLens</span>
        </div>
        <Link to="/jelajah" aria-label="Katalog" className="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#432912] shadow-sm">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" />
          </svg>
        </Link>
      </div>

      {/* HERO MELENGKUNG + LINGKARAN PINDAI FOTO DI TENGAH */}
      <section
        onDragOver={(e) => { e.preventDefault(); setSeret(true); }}
        onDragLeave={() => setSeret(false)}
        onDrop={(e) => { e.preventDefault(); setSeret(false); proses(e.dataTransfer.files?.[0]); }}
        className="relative"
      >
        {/* Lengkungan Cokelat Sogan Atas */}
        <div className={`bg-sogan-grad rounded-[36px] px-6 pb-28 pt-8 text-center text-white shadow-[0_18px_40px_rgba(38,20,9,0.18)] transition-all lg:px-12 lg:pb-32 lg:pt-10 ${
          seret ? "ring-4 ring-[#AD7559]" : ""
        }`}>
          <span className="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3.5 py-1 text-[11px] font-bold tracking-wider text-karamel uppercase">
            ★ Identifikasi Motif AI
          </span>
          <h1 className="mx-auto mt-3 max-w-lg text-2xl font-bold leading-snug tracking-tight sm:text-3xl">
            Kenali Motif Batik dari Satu Foto
          </h1>
          <p className="mx-auto mt-2 max-w-md text-xs leading-relaxed text-white/75 sm:text-sm">
            Unggah atau potret kain batikmu untuk mengetahui nama motif, daerah asal, dan filosofinya.
          </p>
        </div>

        {/* Lingkaran Pindai Interaktif Menembus Batas Lengkungan */}
        <div className="relative z-10 mx-auto -mt-20 flex max-w-sm flex-col items-center">
          <button
            type="button"
            onClick={() => galeri.current?.click()}
            className="group relative flex h-40 w-40 flex-col items-center justify-center rounded-full bg-white p-3 shadow-[0_16px_35px_rgba(38,20,9,0.22)] ring-[6px] ring-[#F3F1ED] transition-transform duration-300 hover:scale-105 active:scale-95 sm:h-44 sm:w-44"
          >
            <div className="flex h-full w-full flex-col items-center justify-center rounded-full border-2 border-dashed border-[#AD7559] bg-[#F3F1ED] transition-colors group-hover:bg-[#D5D2CA]">
              <span className="bg-karamel flex h-11 w-11 items-center justify-center rounded-full text-white shadow-sm">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M4 8h3l2-3h6l2 3h3v11H4z" />
                  <circle cx="12" cy="13" r="3" />
                </svg>
              </span>
              <span className="mt-2 text-xs font-bold text-[#432912]">Unggah Foto</span>
              <span className="text-[10px] font-medium text-[#432912]/55">atau seret ke sini</span>
            </div>
          </button>

          {/* Dua tombol kecil pelengkap di bawah lingkaran */}
          <div className="mt-4 flex items-center gap-2.5">
            <button
              type="button"
              onClick={() => kamera.current?.click()}
              className="bg-karamel rounded-full px-5 py-2 text-xs font-bold text-white shadow-sm transition hover:brightness-105 active:scale-95"
            >
              Ambil Kamera
            </button>
            <button
              type="button"
              onClick={() => galeri.current?.click()}
              className="bg-kapsul rounded-full px-5 py-2 text-xs font-bold text-[#432912]/80 transition hover:bg-[#C59C8A] active:scale-95"
            >
              Pilih Galeri
            </button>
          </div>
        </div>

        <input ref={kamera} type="file" accept="image/*" capture="environment" className="hidden"
          onChange={(e) => { proses(e.target.files?.[0]); e.target.value = ""; }} />
        <input ref={galeri} type="file" accept="image/*" className="hidden"
          onChange={(e) => { proses(e.target.files?.[0]); e.target.value = ""; }} />
      </section>

      {error && (
        <p role="alert" className="rounded-2xl bg-red-50 px-4 py-3 text-center text-xs font-bold text-red-800">
          {error}
        </p>
      )}

      {/* Search Bar Kapsul + Kategori Daerah (Menyatu seperti Referensi Kiri) */}
      <section className="space-y-5 pt-2">
        <div className="bg-kapsul mx-auto flex h-13 max-w-xl items-center rounded-full p-1.5 pl-5">
          <input
            type="search"
            value={cari}
            onChange={(e) => setCari(e.target.value)}
            placeholder="Cari motif batik..."
            className="w-full bg-transparent text-sm font-medium text-[#432912] placeholder:text-[#432912]/40 focus:outline-none"
          />
          <span className="bg-karamel flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-white shadow-sm">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.3" strokeLinecap="round">
              <circle cx="11" cy="11" r="7" />
              <path d="M20 20l-3.5-3.5" />
            </svg>
          </span>
        </div>

        <div>
          <div className="flex items-center justify-between">
            <h2 className="text-base font-bold tracking-tight">Kategori Daerah</h2>
            <Link to="/jelajah" className="text-xs font-bold text-karamel hover:underline">
              Lihat semua
            </Link>
          </div>

          <div className="-mx-5 mt-3 flex gap-2.5 overflow-x-auto px-5 pb-1 lg:mx-0 lg:flex-wrap lg:px-0">
            {daftarDaerah.map((d) => {
              const aktif = daerah === d;
              return (
                <button
                  key={d}
                  type="button"
                  onClick={() => setDaerah(d)}
                  className={`inline-flex shrink-0 items-center gap-1.5 rounded-full px-5 py-2.5 text-xs font-bold transition-all ${
                    aktif
                      ? "bg-karamel text-white shadow-sm"
                      : "bg-kapsul text-[#432912]/70 hover:bg-[#C59C8A]"
                  }`}
                >
                  <span>{aktif ? "✦" : "◈"}</span>
                  <span>{d}</span>
                </button>
              );
            })}
          </div>
        </div>

        {/* Grid Kartu Floating Sogan */}
        {daftarTampil.length === 0 ? (
          <p className="py-8 text-center text-sm text-[#432912]/55">Motif yang dicari tidak ditemukan.</p>
        ) : (
          <div className="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
            {daftarTampil.slice(0, 8).map((m) => (
              <KartuMotifBaru
                key={m.id}
                motif={m}
                favorit={fav.ada(m.id)}
                onToggle={fav.toggle}
              />
            ))}
          </div>
        )}
      </section>
    </div>
  );
}