import { useMemo, useState } from "react";
import { KATALOG } from "../data/katalogMotif";
import KartuMotifBaru from "../components/KartuMotifBaru";
import useFavoritLokal from "../hooks/useFavoritLokal";

export default function ExplorePage() {
  const [daerah, setDaerah] = useState("Semua");
  const [q, setQ] = useState("");
  const fav = useFavoritLokal();

  const daftarDaerah = useMemo(
    () => ["Semua", ...Array.from(new Set(KATALOG.map((m) => m.daerah))).sort()],
    []
  );

  const hasil = KATALOG.filter(
    (m) =>
      (daerah === "Semua" || m.daerah === daerah) &&
      m.nama.toLowerCase().includes(q.trim().toLowerCase())
  );

  return (
    <div>
      <h1 className="text-3xl font-bold">Jelajah motif</h1>
      <p className="mt-1 text-mute">{KATALOG.length} motif dari berbagai daerah</p>

      <label className="mt-5 block">
        <span className="sr-only">Cari nama motif</span>
        <input
          type="search"
          value={q}
          onChange={(e) => setQ(e.target.value)}
          placeholder="Cari nama motif"
          className="h-12 w-full max-w-md rounded-full bg-white px-5 text-nila shadow-sm ring-1 ring-nila/15 placeholder:text-mute"
        />
      </label>

      <div className="-mx-5 mt-4 flex gap-2 overflow-x-auto px-5 pb-1 lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0">
        {daftarDaerah.map((d) => (
          <button
            key={d}
            type="button"
            onClick={() => setDaerah(d)}
            aria-pressed={daerah === d}
            className={`h-11 shrink-0 rounded-full px-5 text-sm font-semibold ${
              daerah === d ? "bg-nila text-kain" : "bg-white text-nila ring-1 ring-nila/20"
            }`}
          >
            {d}
          </button>
        ))}
      </div>

      {hasil.length === 0 ? (
        <p className="mt-10 text-center text-mute">Tidak ada motif yang cocok. Coba kata kunci atau daerah lain.</p>
      ) : (
        <div className="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {hasil.map((m) => (
            <KartuMotifBaru key={m.id} motif={m} favorit={fav.ada(m.id)} onToggle={fav.toggle} />
          ))}
        </div>
      )}
    </div>
  );
}