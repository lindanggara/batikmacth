import { useRef, useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { KATALOG } from "../data/katalogMotif";

const MAKS_MB = 10;
const CONTOH = ["parang", "kawung", "megamendung", "ceplok"].map((id) => KATALOG.find((m) => m.id === id));

export default function HomePage() {
  const nav = useNavigate();
  const kamera = useRef(null);
  const galeri = useRef(null);
  const [error, setError] = useState("");

  function proses(file) {
    setError("");
    if (!file) return;
    if (!file.type.startsWith("image/")) return setError("File harus berupa foto (JPG atau PNG).");
    if (file.size > MAKS_MB * 1024 * 1024) return setError(`Ukuran foto maksimal ${MAKS_MB} MB.`);
    nav("/hasil", { state: { file } });
  }

  return (
    <div>
      <header className="flex items-center gap-3 lg:hidden">
        <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-nila font-display text-xl font-bold text-malam">B</span>
        <span className="font-display text-xl font-bold">BatikLens</span>
      </header>

      <section
        onDragOver={(e) => e.preventDefault()}
        onDrop={(e) => { e.preventDefault(); proses(e.dataTransfer.files?.[0]); }}
        className="relative mt-5 overflow-hidden rounded-[28px] bg-gradient-to-br from-nila-mid to-nila-deep p-6 text-kain shadow-lg lg:mt-0 lg:min-h-[380px] lg:rounded-[40px] lg:p-14"
      >
        <div aria-hidden="true" className="absolute -right-8 top-8 lg:right-20 lg:top-1/2 lg:-translate-y-1/2">
          <div className="pola-kawung h-44 w-44 rotate-12 rounded-[36px] ring-4 ring-malam/80 lg:h-72 lg:w-72 lg:rounded-[48px]" />
          <div className="pola-parang absolute -bottom-6 -left-28 hidden h-40 w-40 -rotate-6 rounded-[36px] ring-4 ring-white/80 lg:block" />
        </div>
        <div className="relative max-w-[62%] lg:max-w-lg">
          <h1 className="text-3xl font-bold leading-tight lg:text-5xl">Kenali batikmu dari satu foto</h1>
          <p className="mt-2 text-sm text-white/80 lg:mt-4 lg:text-lg">Kami tebak motif, asal daerah, dan ciri khasnya.</p>
        </div>
        <div className="relative mt-6 flex flex-wrap gap-3 lg:mt-10">
          <button type="button" onClick={() => kamera.current?.click()}
            className="h-12 rounded-full bg-white px-6 font-semibold text-nila lg:h-14 lg:px-8">Ambil Foto</button>
          <button type="button" onClick={() => galeri.current?.click()}
            className="h-12 rounded-full border border-white/40 px-6 font-semibold text-white lg:h-14 lg:px-8">Dari Galeri</button>
        </div>
        <p className="relative mt-4 hidden text-sm text-white/70 lg:block">Atau seret foto ke area ini. JPG atau PNG, maksimal {MAKS_MB} MB.</p>
        <input ref={kamera} type="file" accept="image/*" capture="environment" className="hidden"
          onChange={(e) => { proses(e.target.files?.[0]); e.target.value = ""; }} />
        <input ref={galeri} type="file" accept="image/*" className="hidden"
          onChange={(e) => { proses(e.target.files?.[0]); e.target.value = ""; }} />
      </section>
      {error && <p role="alert" className="mt-3 rounded-2xl bg-red-50 px-4 py-3 text-sm font-medium text-red-800">{error}</p>}

      <div className="mt-7 lg:mt-10 lg:grid lg:grid-cols-3 lg:gap-6">
        <section className="lg:col-span-2">
          <h2 className="text-lg font-semibold lg:text-xl">Belum punya foto? Coba contoh</h2>
          <div className="mt-3 flex gap-4 lg:gap-5">
            {CONTOH.map((m) => (
              <button key={m.id} type="button" onClick={() => nav("/hasil", { state: { contohId: m.id } })}
                className="w-[72px] text-center lg:w-28" aria-label={`Coba contoh motif ${m.nama}`}>
                <div className={`h-[72px] w-[72px] rounded-2xl shadow-sm ring-2 ring-white lg:h-28 lg:w-28 lg:rounded-3xl ${m.pola}`} />
                <span className="mt-1 block text-xs font-medium lg:text-sm">{m.nama}</span>
              </button>
            ))}
          </div>
        </section>

        <section className="mt-5 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-nila/5 lg:mt-0">
          <h2 className="font-semibold">Tips foto</h2>
          <p className="mt-1 text-sm text-mute">Foto kain dari dekat, cahaya cukup, tanpa lipatan, dan latar yang polos.</p>
        </section>
      </div>

      <section className="mt-7 lg:mt-10">
        <div className="flex items-center justify-between">
          <h2 className="text-lg font-semibold lg:text-xl">Motif populer</h2>
          <Link to="/jelajah" className="text-sm font-semibold text-soga">Lihat semua</Link>
        </div>
        <div className="-mx-5 mt-3 flex snap-x gap-4 overflow-x-auto px-5 pb-2 lg:mx-0 lg:grid lg:grid-cols-6 lg:overflow-visible lg:px-0">
          {KATALOG.slice(0, 6).map((m) => (
            <Link key={m.id} to="/jelajah" className="w-40 shrink-0 snap-start rounded-[28px] bg-white p-2.5 shadow-sm ring-1 ring-nila/5 lg:w-auto">
              <div className={`h-32 rounded-3xl ${m.pola}`} />
              <div className="mt-2 flex items-end justify-between px-1 pb-1">
                <div>
                  <h3 className="font-display font-semibold">{m.nama}</h3>
                  <p className="text-xs text-mute">{m.daerah}</p>
                </div>
                <span className="flex h-9 w-9 items-center justify-center rounded-full bg-nila text-malam" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </span>
              </div>
            </Link>
          ))}
        </div>
      </section>
    </div>
  );
}