import { useEffect, useState } from "react";
import { Link, Navigate, useLocation, useNavigate } from "react-router-dom";
import { cariMotif } from "../api/pencarianLokal";
import KartuMotifBaru from "../components/KartuMotifBaru";
import useFavoritLokal from "../hooks/useFavoritLokal";

const HATI = "M12 20s-7-4.5-7-10a4 4 0 017-2.5A4 4 0 0119 10c0 5.5-7 10-7 10z";

function Belah() {
  return (
    <svg width="10" height="10" viewBox="0 0 14 14" className="text-malam" aria-hidden="true">
      <path d="M7 0l7 7-7 7-7-7z" fill="currentColor" />
    </svg>
  );
}

export default function ResultPage() {
  const { state } = useLocation();
  const nav = useNavigate();
  const fav = useFavoritLokal();
  const file = state?.file;
  const contohId = state?.contohId;
  const [fotoUrl, setFotoUrl] = useState(null);
  const [hasil, setHasil] = useState(null);
  const [error, setError] = useState("");
  const [nilai, setNilai] = useState(null);

  useEffect(() => {
    if (!file) return;
    const u = URL.createObjectURL(file);
    setFotoUrl(u);
    return () => URL.revokeObjectURL(u);
  }, [file]);

  useEffect(() => {
    if (!file && !contohId) return;
    let batal = false;
    setHasil(null);
    setError("");
    cariMotif({ file, contohId })
      .then((h) => !batal && setHasil(h))
      .catch(() => !batal && setError("Pencarian gagal. Silakan coba beberapa saat lagi."));
    return () => { batal = true; };
  }, [file, contohId]);

  if (!file && !contohId) return <Navigate to="/" replace />;

  const kembali = (
    <button
      type="button"
      onClick={() => nav(-1)}
      className="group mb-6 inline-flex h-10 items-center gap-2 text-sm font-medium text-nila/70 transition-colors hover:text-nila"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" className="transition-transform group-hover:-translate-x-1">
        <path d="M19 12H5M11 6l-6 6 6 6" />
      </svg>
      Kembali
    </button>
  );

  if (error) {
    return (
      <div>
        {kembali}
        <div className="mt-6 rounded-3xl bg-white p-8 text-center shadow-sm ring-1 ring-malam/40">
          <p role="alert" className="text-base font-medium text-red-800">{error}</p>
          <Link to="/" className="mt-5 inline-flex h-12 items-center rounded-full bg-nila px-8 font-semibold text-kain">
            Coba lagi
          </Link>
        </div>
      </div>
    );
  }

  if (!hasil) {
    return (
      <div>
        {kembali}
        <div role="status" className="mt-20 flex flex-col items-center gap-5">
          <div className="rounded-2xl bg-white p-2 shadow-md ring-1 ring-malam/60">
            <div className="pola-kawung h-24 w-24 animate-pulse rounded-xl" aria-hidden="true" />
          </div>
          <p className="font-display text-2xl font-medium">Menganalisis struktur motif...</p>
        </div>
      </div>
    );
  }

  const t = hasil.tebakan;
  const favorit = fav.ada(t.id);

  return (
    <div>
      {kembali}
      <div className="lg:grid lg:grid-cols-[5fr_6fr] lg:items-start lg:gap-14">
        <div className="mx-auto w-full max-w-sm lg:sticky lg:top-28 lg:max-w-none">
          <div className="relative rounded-[32px] bg-white p-2.5 shadow-lg ring-1 ring-malam/70">
            <div className="aspect-[4/5] overflow-hidden rounded-[24px]">
              {fotoUrl
                ? <img src={fotoUrl} alt="Foto kain yang kamu unggah" className="h-full w-full object-cover" />
                : <div className={`h-full w-full ${t.pola}`} role="img" aria-label={`Contoh motif ${t.nama}`} />}
            </div>
            <div className="mt-3 flex items-center justify-between px-2 pb-1">
              <span className="text-xs font-medium tracking-wider text-mute uppercase">Tingkat Keyakinan</span>
              <span className={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ${
                hasil.yakin ? "bg-nila text-malam" : "bg-malam/20 text-nila"
              }`}>
                <Belah />
                {hasil.yakin ? "Tinggi (Yakin)" : "Perlu Verifikasi"}
              </span>
            </div>
          </div>
        </div>

        <div className="mt-8 lg:mt-0">
          <div className="border-b border-nila/10 pb-6">
            <p className="text-xs font-semibold tracking-widest text-soga uppercase">Hasil Identifikasi</p>
            <h1 className="mt-1 font-display text-5xl font-semibold leading-none lg:text-7xl">{t.nama}</h1>
            <p className="mt-3 text-base font-medium tracking-wide text-mute uppercase">{t.daerah}</p>
          </div>

          {!hasil.yakin && (
            <p className="mt-5 rounded-2xl border border-malam/60 bg-malam/15 px-4 py-3 text-sm leading-relaxed">
              Tingkat kemiripan belum sepenuhnya dominan. Pastikan pencahayaan merata dan bandingkan dengan motif kerabat di bawah ini.
            </p>
          )}

          <section className="mt-7">
            <h2 className="font-display text-2xl font-semibold">Karakteristik &amp; Filosofi</h2>
            <p className="mt-2.5 max-w-xl leading-relaxed text-nila/85">{t.ciri}</p>
          </section>

          <section className="mt-8 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-nila/10">
            {nilai === null ? (
              <div className="flex flex-wrap items-center justify-between gap-3">
                <span className="text-sm font-medium">Apakah hasil tebakan ini akurat?</span>
                <div className="flex gap-2.5">
                  <button type="button" onClick={() => setNilai("ya")} className="h-10 rounded-full bg-nila px-6 text-sm font-semibold text-kain transition-opacity hover:opacity-90">
                    Ya, sesuai
                  </button>
                  <button type="button" onClick={() => setNilai("tidak")} className="h-10 rounded-full border border-nila/30 px-6 text-sm font-semibold transition-colors hover:bg-nila/5">
                    Kurang tepat
                  </button>
                </div>
              </div>
            ) : (
              <p role="status" className="text-sm font-medium text-soga">Terima kasih, masukanmu membantu evaluasi model kami.</p>
            )}
          </section>

          <section className="mt-10 border-t border-nila/10 pt-8">
            <h2 className="font-display text-2xl font-semibold">Motif kerabat yang mirip</h2>
            <div className="mt-5 grid grid-cols-3 gap-4">
              {hasil.mirip.map(({ motif, label }) => (
                <KartuMotifBaru key={motif.id} motif={motif} label={label} favorit={fav.ada(motif.id)} onToggle={fav.toggle} />
              ))}
            </div>
          </section>

          <div className="mt-10 flex gap-3.5">
            <Link to="/" className="flex h-14 flex-1 items-center justify-center rounded-full bg-nila text-base font-semibold text-kain shadow-md transition-all hover:brightness-110">
              Identifikasi Foto Lain
            </Link>
            <button
              type="button"
              onClick={() => fav.toggle(t.id)}
              aria-pressed={favorit}
              aria-label={favorit ? "Hapus dari favorit" : "Simpan ke favorit"}
              className="flex h-14 w-14 items-center justify-center rounded-full bg-white text-soga shadow-sm ring-1 ring-malam/60 transition-transform hover:scale-105 active:scale-95"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" strokeWidth="1.8" strokeLinejoin="round"
                fill={favorit ? "currentColor" : "none"} stroke="currentColor" aria-hidden="true">
                <path d={HATI} />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}