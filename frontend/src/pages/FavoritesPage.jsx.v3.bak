import { Link } from "react-router-dom";
import { KATALOG } from "../data/katalogMotif";
import KartuMotifBaru from "../components/KartuMotifBaru";
import useFavoritLokal from "../hooks/useFavoritLokal";

export default function FavoritesPage() {
  const fav = useFavoritLokal();
  const daftar = KATALOG.filter((m) => fav.ada(m.id));

  return (
    <div>
      <h1 className="font-display text-5xl font-semibold lg:text-6xl">Favorit</h1>

      {daftar.length === 0 ? (
        <div className="mt-12 max-w-md">
          <div className="inline-block rounded-2xl p-1.5 ring-1 ring-malam/60">
            <div className="pola-kawung h-24 w-24 rounded-xl" aria-hidden="true" />
          </div>
          <h2 className="mt-6 font-display text-3xl font-semibold">Belum ada motif tersimpan</h2>
          <p className="mt-2 text-mute">Tekan ikon hati pada sebuah motif di halaman Jelajah untuk menyimpannya di sini.</p>
          <Link to="/jelajah" className="mt-6 inline-flex h-12 items-center rounded-full bg-nila px-8 font-semibold text-kain">
            Jelajah motif
          </Link>
        </div>
      ) : (
        <>
          <p className="mt-2 text-mute">{daftar.length} motif tersimpan</p>
          <div className="mt-8 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
            {daftar.map((m) => (
              <KartuMotifBaru key={m.id} motif={m} favorit onToggle={fav.toggle} />
            ))}
          </div>
        </>
      )}
    </div>
  );
}