import { useMemo, useRef, useState } from "react";
import { Link, useNavigate } from "react-router-dom";
import { KATALOG } from "../data/katalogMotif";
import KartuMotifBaru from "../components/KartuMotifBaru";
import useFavoritLokal from "../hooks/useFavoritLokal";

const MAKS_MB = 10;

export default function HomePage() {
  const nav = useNavigate();
  const fav = useFavoritLokal();
  const kamera = useRef(null);
  const galeri = useRef(null);
  const [error, setError] = useState("");
  const [daerah, setDaerah] = useState("Semua");
  const [cari, setCari] = useState("");

  const daftarDaerah = useMemo(
    () => ["Semua", ...Array.from(new Set(KATALOG.map((m) => m.daerah))).slice(0, 5)],
    []
  );

  const daftarTampil = useMemo(() => {
    return KATALOG.filter(
      (m) =>
        (daerah === "Semua" || m.daerah === daerah) &&
        m.nama.toLowerCase().includes(cari.trim().toLowerCase())
    );
  }, [daerah, cari]);

  function proses(file) {
    setError("");
    if (!file) return;
    if (!file.type.startsWith("image/")) return setError("File harus berupa foto (JPG atau PNG).");
    if (file.size > MAKS_MB * 1024 * 1024) return setError(`Ukuran foto maksimal ${MAKS_MB} MB.`);
    nav("/hasil", { state: { file } });
  }

  return (
    <div className="space-y-8 lg:space-y-10">
      {/* Top Bar Mobile ala Referensi */}
      <div className="flex items-center justify-between lg:hidden">
        <span className="bg-sogan-tua flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold text-[#FAF7F2]">
          ✦
        </span>
        <div className="flex items-center gap-1.5 text-sm font-bold">
          <span className="text-karamel">📍</span>
          <span>BatikLens Nusantara</span>
        </div>
        <Link to="/jelajah" aria-label="Katalog" className="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#3D2314] shadow-sm">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" />
          </svg>
        </Link>
      </div>

      {/* Baris Atas: Search Capsule + Tombol Pindai Foto */}
      <div className="grid gap-4 lg:grid-cols-[1.2fr_1fr] lg:items-center">
        {/* Kapsul Pencarian */}
        <div className="flex h-14 items-center rounded-full bg-[#EFEAE2] p-1.5 pl-5 shadow-inner">
          <input
            type="search"
            value={cari}
            onChange={(e) => setCari(e.target.value)}
            placeholder="Cari motif batik (Parang, Kawung...)"
            className="w-full bg-transparent text-sm font-medium text-[#2B180D] placeholder:text-[#2B180D]/40 focus:outline-none"
          />
          <button
            type="button"
            onClick={() => nav("/jelajah")}
            aria-label="Cari motif"
            className="bg-karamel flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-white shadow-sm transition hover:brightness-105"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round">
              <circle cx="11" cy="11" r="7" />
              <path d="M20 20l-3.5-3.5" />
            </svg>
          </button>
        </div>

        {/* Kartu Cepat Pindai Foto Batik */}
        <div
          onDragOver={(e) => e.preventDefault()}
          onDrop={(e) => { e.preventDefault(); proses(e.dataTransfer.files?.[0]); }}
          className="bg-sogan-grad flex items-center justify-between gap-3 rounded-full p-2 pl-5 text-white shadow-md"
        >
          <div className="min-w-0">
            <p className="truncate text-xs font-semibold text-karamel uppercase tracking-wider">Identifikasi AI</p>
            <p className="truncate text-sm font-bold">Pindai Foto Batikmu</p>
          </div>
          <div className="flex shrink-0 gap-2">
            <button
              type="button"
              onClick={() => kamera.current?.click()}
              className="bg-karamel rounded-full px-4 py-2.5 text-xs font-bold text-white shadow transition hover:brightness-105 active:scale-95"
            >
              📷 Kamera
            </button>
            <button
              type="button"
              onClick={() => galeri.current?.click()}
              className="rounded-full bg-white/15 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-white/25 active:scale-95"
            >
              Galeri
            </button>
          </div>
          <input ref={kamera} type="file" accept="image/*" capture="environment" className="hidden"
            onChange={(e) => { proses(e.target.files?.[0]); e.target.value = ""; }} />
          <input ref={galeri} type="file" accept="image/*" className="hidden"
            onChange={(e) => { proses(e.target.files?.[0]); e.target.value = ""; }} />
        </div>
      </div>

      {error && (
        <p role="alert" className="rounded-2xl bg-red-50 px-4 py-3 text-sm font-medium text-red-800">
          {error}
        </p>
      )}

      {/* Bagian Kategori (Pil Kapsul seperti referensi) */}
      <section>
        <div className="flex items-center justify-between">
          <h2 className="font-display text-2xl font-bold">Asal Daerah</h2>
          <Link to="/jelajah" className="text-xs font-semibold text-karamel hover:underline">
            Lihat semua
          </Link>
        </div>

        <div className="-mx-5 mt-3 flex gap-2.5 overflow-x-auto px-5 pb-1 lg:mx-0 lg:flex-wrap lg:px-0">
          {daftarDaerah.map((d) => {
            const aktif = daerah === d;
            return (
              <button
                key={d}
                type="button"
                onClick={() => setDaerah(d)}
                className={`inline-flex shrink-0 items-center gap-2 rounded-full px-5 py-2.5 text-xs font-bold transition-all ${
                  aktif
                    ? "bg-karamel text-white shadow-sm"
                    : "bg-[#EFEAE2] text-[#2B180D]/75 hover:bg-[#E5DEC9]"
                }`}
              >
                <span>{aktif ? "✦" : "◈"}</span>
                <span>{d}</span>
              </button>
            );
          })}
        </div>
      </section>

      {/* Grid Kartu Floating Sogan */}
      <section>
        {daftarTampil.length === 0 ? (
          <p className="py-10 text-center text-sm text-[#2B180D]/60">Motif tidak ditemukan.</p>
        ) : (
          <div className="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
            {daftarTampil.slice(0, 8).map((m) => (
              <KartuMotifBaru
                key={m.id}
                motif={m}
                favorit={fav.ada(m.id)}
                onToggle={fav.toggle}
              />
            ))}
          </div>
        )}
      </section>
    </div>
  );
}