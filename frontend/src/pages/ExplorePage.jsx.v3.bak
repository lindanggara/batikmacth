import { useMemo, useState } from "react";
import { KATALOG } from "../data/katalogMotif";
import KartuMotifBaru from "../components/KartuMotifBaru";
import useFavoritLokal from "../hooks/useFavoritLokal";

export default function ExplorePage() {
  const [daerah, setDaerah] = useState("Semua");
  const [q, setQ] = useState("");
  const fav = useFavoritLokal();

  const daftarDaerah = useMemo(
    () => ["Semua", ...Array.from(new Set(KATALOG.map((m) => m.daerah))).sort()],
    []
  );

  const hasil = KATALOG.filter(
    (m) =>
      (daerah === "Semua" || m.daerah === daerah) &&
      m.nama.toLowerCase().includes(q.trim().toLowerCase())
  );

  return (
    <div>
      <h1 className="font-display text-5xl font-semibold lg:text-6xl">Jelajah motif</h1>
      <p className="mt-2 text-mute">{KATALOG.length} motif dari berbagai daerah</p>

      <label className="mt-8 block max-w-md">
        <span className="sr-only">Cari nama motif</span>
        <input
          type="search"
          value={q}
          onChange={(e) => setQ(e.target.value)}
          placeholder="Cari nama motif"
          className="h-12 w-full border-b border-nila/30 bg-transparent px-1 text-nila placeholder:text-mute"
        />
      </label>

      <div className="-mx-5 mt-4 flex gap-7 overflow-x-auto px-5 lg:mx-0 lg:flex-wrap lg:px-0">
        {daftarDaerah.map((d) => (
          <button
            key={d}
            type="button"
            onClick={() => setDaerah(d)}
            aria-pressed={daerah === d}
            className={`min-h-[44px] shrink-0 border-b-2 text-sm font-medium ${
              daerah === d ? "border-malam text-nila" : "border-transparent text-nila/60"
            }`}
          >
            {d}
          </button>
        ))}
      </div>

      {hasil.length === 0 ? (
        <p className="mt-12 text-mute">Tidak ada motif yang cocok. Coba kata kunci atau daerah lain.</p>
      ) : (
        <div className="mt-8 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {hasil.map((m) => (
            <KartuMotifBaru key={m.id} motif={m} favorit={fav.ada(m.id)} onToggle={fav.toggle} />
          ))}
        </div>
      )}
    </div>
  );
}